[project]
name = {{ distribution_name | tojson }}
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
requires-python = ">=3.10,<3.12"
authors = [
    { name = {{ author_name | tojson }}, email = {{ author_email | tojson }} },
]
dependencies = [
    "datalab-server",
]

[project.entry-points."pydatalab.tools"]
{{ tool_id | tojson }} = "{{ distribution_name | replace('-', '_') }}.provider:{{ (tool_id[:-5] if tool_id.endswith('-tool') else tool_id) | replace('-', ' ') | title | replace(' ', '') }}ToolProvider"

[build-system]
requires = ["setuptools>=77", "wheel"]
build-backend = "setuptools.build_meta"

[tool.setuptools.package-data]
{% if tool_ui_kind == "in-app" -%}
{{ distribution_name | replace('-', '_') | tojson }} = ["static/frontend/*.js"]
{% else -%}
{{ distribution_name | replace('-', '_') | tojson }} = ["static/*"]
{% endif %}
