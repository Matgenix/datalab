import ToolView from "./ToolView.vue";
import styles from "./tool.css?inline";

const TOOL_ID = {{ tool_id | tojson }};
const SDK_VERSION = 1;
const sdk = window.DatalabToolSDK;

if (!sdk || sdk.version !== SDK_VERSION) {
  throw new Error(`Tool ${TOOL_ID} requires datalab frontend SDK ${SDK_VERSION}.`);
}

const styleId = `datalab-tool-${TOOL_ID}-styles`;
if (!document.getElementById(styleId)) {
  const style = document.createElement("style");
  style.id = styleId;
  style.textContent = styles;
  document.head.appendChild(style);
}

sdk.register({
  id: TOOL_ID,
  sdkVersion: SDK_VERSION,
  component: ToolView,
});
